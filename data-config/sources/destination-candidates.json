  "schemaVersion": 1,
  "status": "planning-only",
  "purpose": "Candidate intake for the next 45 destinations. This file is not consumed by the ingest or public build and contains no production climate, DEM, score or ranking data.",
  "commonDataRequirements": {
    "climate": "Stage reanalysis-era5-land-timeseries for 1991-2020 with hourly temperature, wind, precipitation, snow depth and snow cover; verify units and de-accumulated precipitation before scoring.",
    "elevation": "Stage COP-DEM_GLO-30 tiles covering the reviewed destination polygon; retain source metadata, vertical units and explicit nodata/ocean exclusions.",
    "geometry": "Create a versioned trekking-area polygon, exclude open water and unrelated urban/lowland fringe, document the polygon source and review it before sampling.",
    "sampling": "Run the existing elevation-aware band sampler with 1-3 valid points per band (the current configured maximum is 3) where terrain permits; record masked cells, point separation and elevation mismatch.",
    "release": "Keep active=false until real-data staging, data-quality checks, science review and operator approvals are complete. Never infer climate values from this candidate file."
  },
  "regionRequirements": {
    "alps": "Use a reviewed massif or park polygon; split valley, alpine and high-alpine bands where relief exceeds 1,500 m and probe for glacier/ocean masks.",
    "dolomites": "Use a reviewed mountain-group polygon rather than a town radius; validate limestone massif edges, valleys and high-altitude trail zones.",
    "pyrenees": "Use the named valley or park corridor and keep French/Spanish/Andorran border geometry explicit; validate high passes separately.",
    "british-isles": "Use national-park/fell geometry and exclude sea and large lakes; expect more rain and lower-relief bands than the Alps.",
    "scandinavia": "Use island or mountain-park geometry with coastline/water exclusions; validate high-latitude daylight and snow-season coverage.",
    "balkans": "Use park boundaries and exclude lakes/canyons from terrain sampling; check DEM tile coverage across fragmented karst terrain.",
    "canadian-rockies": "Use park boundaries or a defined trail region, not a city radius; validate glacier, lake and forest-edge sampling cells.",
    "coast-mountains": "Use a resort/mountain corridor polygon and exclude the urban valley; validate maritime precipitation and treeline-to-alpine bands.",
    "rockies": "Use one park polygon per destination and exclude deep canyon/water cells; retain broad elevation bands for strong summer/winter contrast.",
    "sierra-nevada": "Use the named park boundary and exclude reservoirs/urban foothills; validate dry-summer precipitation and high-pass snow bands.",
    "pacific-northwest": "Use a park or wilderness polygon and exclude coastline/water; validate maritime rain, forest and alpine transition cells.",
    "colorado-plateau": "Use a canyon-park polygon and exclude river/water cells; validate hot-season thresholds, exposed desert bands and rim elevations.",
    "patagonia": "Use the official park/trail-sector footprint and retain wind-exposure metadata; validate coastal/glacier masks and sparse high-elevation points.",
    "andes": "Use a park or trekking-circuit polygon with explicit high-altitude corridors; validate steep elevation gradients, snow/ice masks and border geometry.",
    "himalaya": "Use a named trekking-region polygon rather than a country-wide area; validate DEM coverage, extreme elevation bands and sparse/no-data points.",
    "japanese-alps": "Use the named park or massif boundary and exclude dense urban valleys; validate seasonal snow and forest-to-alpine transitions.",
    "east-asia": "Use park/mountain-area geometry and exclude urban/coastal fringe; validate monsoon-season precipitation and forest elevation bands.",
    "new-zealand-alps": "Use a Great Walk/park corridor and exclude fiords/lakes; validate high-rainfall coastal cells and rapidly changing elevation.",
    "new-zealand-volcanic": "Use volcanic park geometry with crater/lake masks; validate exposed alpine plateau and lower forest bands.",
    "australian-highlands": "Use park geometry and exclude urban fringe; validate bushfire-season metadata separately during science review.",
    "tasmania": "Use wilderness-area/trail geometry and exclude lakes; validate wet western slopes and snow-prone alpine plateaus.",
    "australian-outback": "Use the trail corridor only, not the entire desert region; validate sparse DEM points and hot-season safety thresholds.",
    "atlas": "Use a trekking valley or park corridor and exclude settled lowlands; validate strong dry-side/wet-side elevation gradients.",
    "east-africa-highlands": "Use the official route/park footprint and explicit summit bands; validate cloud, snow/ice and high-altitude no-data cells."
  },
