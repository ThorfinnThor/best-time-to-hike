FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BTH_DATA_PYTHON=/opt/bth-data-venv/bin/python3

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@11.22.0

WORKDIR /app
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml requirements-data.txt ./
RUN install_status=0; \
    pnpm install --frozen-lockfile || install_status=$?; \
    if [ "$install_status" -ne 0 ]; then \
      if ! { test "$install_status" -eq 134 \
        && test -x node_modules/.bin/tsx \
        && test -f node_modules/geotiff/package.json; }; then \
        exit "$install_status"; \
      fi; \
    fi; \
    python3 -m venv /opt/bth-data-venv \
    && /opt/bth-data-venv/bin/python3 -m pip install --no-cache-dir -r requirements-data.txt

COPY --chown=node:node . .
RUN chown node:node /app
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

CMD ["python3", "cloudflare/data-pipeline/server.py"]
