{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","id","month","region","theme","indexable","entries"],
  "properties":{
    "schemaVersion":{"const":1},"id":{"$ref":"#/$defs/slug"},"month":{"type":"integer","minimum":1,"maximum":12},"region":{"$ref":"#/$defs/slug"},"theme":{"enum":["all","warm","snow-free","low-rain"]},"indexable":{"type":"boolean"},
    "entries":{"type":"array","items":{"type":"object","required":["rank","slug","name","countryCode","score","confidence","tempC","wet","snow"],"properties":{"rank":{"type":"integer","minimum":1},"slug":{"$ref":"#/$defs/slug"},"name":{"type":"string","minLength":1},"countryCode":{"type":"string","pattern":"^[A-Z]{2}$"},"score":{"$ref":"#/$defs/score"},"confidence":{"$ref":"#/$defs/score"},"tempC":{"type":"number","minimum":-100,"maximum":70},"wet":{"$ref":"#/$defs/probability"},"snow":{"$ref":"#/$defs/probability"}},"additionalProperties":false}}
  },
  "additionalProperties":false,
  "$defs":{"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"score":{"type":"number","minimum":0,"maximum":100},"probability":{"type":"number","minimum":0,"maximum":1}}
}
