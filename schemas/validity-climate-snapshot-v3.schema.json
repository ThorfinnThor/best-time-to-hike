{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","datasetStatus","destinationId","fixture","climateNormal","bands","aggregationPolicyVersion","migrationStatus","validityEvidence"],
  "properties":{
    "schemaVersion":{"const":3},"datasetStatus":{"const":"provisional"},"destinationId":{"type":"string"},"fixture":{"const":false},
    "aggregationPolicyVersion":{"const":"observation-validity-v1"},"migrationStatus":{"const":"candidate-not-published"},
    "climateNormal":{"type":"object","required":["startYear","endYear"],"properties":{"startYear":{"const":1991},"endYear":{"const":2020}}},
    "validityEvidence":{"type":"object","additionalProperties":false,"required":["githubActionsRun","decisionSha256","reportSha256","scientificCoreSha256","sourceSha256","sourceIdenticalToPublished"],"properties":{"githubActionsRun":{"type":"integer"},"decisionSha256":{"$ref":"#/$defs/hash"},"reportSha256":{"$ref":"#/$defs/hash"},"scientificCoreSha256":{"$ref":"#/$defs/hash"},"sourceSha256":{"$ref":"#/$defs/hash"},"sourceIdenticalToPublished":{"const":true}}},
    "bands":{"type":"object","additionalProperties":false,"required":["representative"],"properties":{"representative":{"type":"object","additionalProperties":false,"required":["months"],"properties":{"months":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/month"}}}}}}
  },
