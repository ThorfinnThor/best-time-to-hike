    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"nullableNumber":{"type":["number","null"]},
    "month":{"type":"object","required":["month","bandId","targetElevationM","meanElevationMismatchM","samplePointCount","samplePointMaxSeparationKm","polygonEquivalentDiameterKm","terrainReliefM","temperatureHikingMeanC","temperatureHikingP10C","temperatureHikingP90C","temperatureUtilityScore","wetDayProbability","heavyRainDayProbability","precipitationMonthlyMeanMm","snowDayProbability","snowDepthMeanOnSnowDaysM","windHikingMeanKmh","highWindHourProbability","severeWindHourProbability","hotDayProbability","severeHotDayProbability","daylightHoursMean","relativeHumidityHikingMeanPct","sampleYearCount","dataCompleteness","interannualScoreSd","validInterannualYearCount","scoringInputsAvailable","missingScoringInputs","observationCoverage","interannualYearlyScores"],"additionalProperties":false,"properties":{
      "month":{"type":"integer","minimum":1,"maximum":12},"bandId":{"const":"representative"},"targetElevationM":{"type":"number"},"meanElevationMismatchM":{"type":"number","minimum":0},"samplePointCount":{"const":1},"samplePointMaxSeparationKm":{"type":"number","minimum":0},"polygonEquivalentDiameterKm":{"type":"number","minimum":0},"terrainReliefM":{"type":"number","minimum":0},
      "temperatureHikingMeanC":{"$ref":"#/$defs/nullableNumber"},"temperatureHikingP10C":{"$ref":"#/$defs/nullableNumber"},"temperatureHikingP90C":{"$ref":"#/$defs/nullableNumber"},"temperatureUtilityScore":{"$ref":"#/$defs/nullableNumber"},"wetDayProbability":{"$ref":"#/$defs/nullableNumber"},"heavyRainDayProbability":{"$ref":"#/$defs/nullableNumber"},"precipitationMonthlyMeanMm":{"$ref":"#/$defs/nullableNumber"},"snowDayProbability":{"$ref":"#/$defs/nullableNumber"},"snowDepthMeanOnSnowDaysM":{"$ref":"#/$defs/nullableNumber"},"windHikingMeanKmh":{"$ref":"#/$defs/nullableNumber"},"highWindHourProbability":{"$ref":"#/$defs/nullableNumber"},"severeWindHourProbability":{"$ref":"#/$defs/nullableNumber"},"hotDayProbability":{"$ref":"#/$defs/nullableNumber"},"severeHotDayProbability":{"$ref":"#/$defs/nullableNumber"},"daylightHoursMean":{"$ref":"#/$defs/nullableNumber"},"relativeHumidityHikingMeanPct":{"$ref":"#/$defs/nullableNumber"},"sampleYearCount":{"type":"integer","minimum":0,"maximum":30},"dataCompleteness":{"$ref":"#/$defs/nullableNumber"},
      "interannualScoreSd":{"$ref":"#/$defs/nullableNumber"},"validInterannualYearCount":{"type":"integer","minimum":0,"maximum":30},"scoringInputsAvailable":{"type":"boolean"},"missingScoringInputs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"observationCoverage":{"type":"object","required":["validYearsByMetric","years"]},"interannualYearlyScores":{"type":"array","maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["year","score"],"properties":{"year":{"type":"integer","minimum":1991,"maximum":2020},"score":{"type":"number","minimum":0,"maximum":100}}}}
    }}
  }
}
