{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://besttimetohike.com/schemas/destination.schema.json",
  "type": "object",
  "required": ["schemaVersion","algorithmVersion","datasetStatus","id","slug","name","countryCode","countryName","continent","region","timezone","tags","coordinates","elevationBands","elevation","months","bestMonths","alternatives","provenance","updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "algorithmVersion": {"type":"string"},
    "datasetStatus": {"enum":["fixture","production"]},
    "id": {"type":"string","minLength":1}, "slug": {"type":"string","pattern":"^[a-z0-9-]+$"}, "name": {"type":"string"},
    "countryCode": {"type":"string","pattern":"^[A-Z]{2}$"}, "countryName": {"type":"string"}, "continent": {"type":"string"}, "region": {"type":"string"}, "timezone": {"type":"string"},
    "tags": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "coordinates": {"type":"object","required":["lat","lon"],"properties":{"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180}},"additionalProperties":false},
    "elevationBands": {"type":"array","minItems":1,"items":{"type":"object","required":["id","minM","maxM","weight"],"properties":{"id":{"type":"string"},"minM":{"type":"number"},"maxM":{"type":"number"},"weight":{"type":"number","exclusiveMinimum":0,"maximum":1}},"additionalProperties":false}},
    "elevation": {"type":"object","required":["minM","medianM","maxM"]},
    "months": {"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/month"}},
    "bestMonths": {"type":"array","items":{"type":"integer","minimum":1,"maximum":12}},
    "alternatives": {"type":"array","items":{"type":"string"}}, "provenance": {"type":"object"}, "updatedAt": {"type":"string"}
  },
  "$defs": {
    "score": {"type":"number","minimum":0,"maximum":100},
    "month": {
      "type":"object",
      "required":["month","overallScore","scoreLevel","confidenceScore","confidenceLevel","components","metrics","bands","reasons","caveats"],
      "properties": {
        "month":{"type":"integer","minimum":1,"maximum":12}, "overallScore":{"$ref":"#/$defs/score"}, "scoreLevel":{"enum":["excellent","very-good","good","fair","poor"]}, "confidenceScore":{"$ref":"#/$defs/score"}, "confidenceLevel":{"enum":["high","moderate","low"]},
        "components":{"type":"object","required":["temperature","precipitation","snow","heatStress","wind","daylight"]}, "metrics":{"type":"object"}, "bands":{"type":"array","minItems":1}, "reasons":{"type":"array"}, "caveats":{"type":"array"}
      }
    }
  }
}
