{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","datasetStatus","aggregationPolicyVersion","destinationId","holdReasons","confidenceInputProvenance","months","bestMonths","productionReleaseApproval"],
  "additionalProperties":false,
  "properties":{
    "schemaVersion":{"const":1},"datasetStatus":{"const":"staging-only"},
    "aggregationPolicyVersion":{"const":"observation-validity-v1"},
    "destinationId":{"type":"string","pattern":"^[a-z0-9-]+$"},
    "holdReasons":{"type":"array","items":{"type":"string"}},
    "confidenceInputProvenance":{"enum":[null,"existing-published-spatial-geometry"]},
    "productionReleaseApproval":{"const":false},
    "bestMonths":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":12}},
    "months":{"type":"array","minItems":12,"maxItems":12,"items":{
      "type":"object","required":["month","recommendationEligible","overallScore","scoreLevel","components","missingScoringInputs","reason","metrics","coverage","interannual","confidence"],
      "allOf":[
        {"if":{"properties":{"reason":{"type":"string"}}},"then":{"properties":{"overallScore":{"const":null},"scoreLevel":{"const":null},"components":{"const":null},"recommendationEligible":{"const":false}}}},
        {"if":{"properties":{"recommendationEligible":{"const":true}}},"then":{"properties":{"overallScore":{"type":"number"},"components":{"type":"object"},"reason":{"const":null},"missingScoringInputs":{"maxItems":0}}}}
      ],
      "properties":{
        "month":{"type":"integer","minimum":1,"maximum":12},"recommendationEligible":{"type":"boolean"},
        "overallScore":{"type":["number","null"],"minimum":0,"maximum":100},
        "scoreLevel":{"enum":[null,"excellent","very-good","good","fair","poor"]},
        "components":{"type":["object","null"],"additionalProperties":{"type":"number","minimum":0,"maximum":100}},
        "missingScoringInputs":{"type":"array","items":{"type":"string"}},"reason":{"type":["string","null"]},
        "metrics":{"type":"object","additionalProperties":{"type":["number","null"]}},
        "coverage":{"type":"object","required":["validYearsByMetric","years"]},
        "confidence":{"type":["object","null"],"additionalProperties":false,"required":["score","level","rawScore"],"properties":{"score":{"type":"number","minimum":0,"maximum":100},"level":{"enum":["high","moderate","low"]},"rawScore":{"type":"number","minimum":0,"maximum":100}}},
        "interannual":{"type":"object","additionalProperties":false,"required":["validInterannualYearCount","scoreStandardDeviation","yearlyScores"],"properties":{
          "validInterannualYearCount":{"type":"integer","minimum":0,"maximum":30},
          "scoreStandardDeviation":{"type":["number","null"],"minimum":0},
          "yearlyScores":{"type":"array","maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["year","score"],"properties":{"year":{"type":"integer","minimum":1991,"maximum":2020},"score":{"type":"number","minimum":0,"maximum":100}}}}
        }}
      }
    }}
  }
}
