{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","status","aggregationPolicyVersion","decisionFile","decisionSha256","summary","results"],
  "properties":{
    "schemaVersion":{"const":1},"status":{"const":"review-only-not-published"},"aggregationPolicyVersion":{"const":"observation-validity-v1"},
    "decisionFile":{"const":"data-config/methodology/validity-migration-decision-v1.json"},"decisionSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "summary":{"type":"object","required":["destinations","months","changedEligibilityMonths","changedBestMonthDestinations","changedRoundedScoreMonths","destinationsWithMissingInputs"],"properties":{"destinations":{"const":10},"months":{"const":120},"changedEligibilityMonths":{"type":"integer","minimum":0},"changedBestMonthDestinations":{"type":"integer","minimum":0},"changedRoundedScoreMonths":{"type":"integer","minimum":0},"destinationsWithMissingInputs":{"type":"array","items":{"type":"string"}}}},
    "results":{"type":"array","minItems":10,"maxItems":10,"items":{"type":"object","required":["destinationId","evidenceSha256","sourceIdenticalToPublished","holdReasons","before","after","months"],"properties":{"destinationId":{"type":"string"},"evidenceSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sourceIdenticalToPublished":{"const":true},"holdReasons":{"type":"array","items":{"type":"string"}},"before":{"type":"object"},"after":{"type":"object"},"months":{"type":"array","minItems":12,"maxItems":12,"items":{"type":"object"}}}}}
