{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["type","features"],
  "properties":{
    "type":{"const":"FeatureCollection"},
    "features":{"type":"array","minItems":1,"items":{"type":"object","required":["type","properties","geometry"],"properties":{
      "type":{"const":"Feature"},
      "properties":{"type":"object","required":["destinationId","provenance"],"properties":{"destinationId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"provenance":{"type":"object","required":["status","sourceType","sourceLabel","intendedScope","excludedClasses","bandRationale","weightRationale"],"properties":{"status":{"enum":["pending-review","reviewed"]},"sourceType":{"enum":["project-curated-draft","official-boundary","osm"]},"sourceLabel":{"type":"string","minLength":1},"intendedScope":{"type":"string","minLength":1},"excludedClasses":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"bandRationale":{"type":"string","minLength":1},"weightRationale":{"type":"string","minLength":1},"reviewer":{"type":"string","minLength":1}},"additionalProperties":false}},"additionalProperties":false},
      "geometry":{"oneOf":[{"$ref":"#/$defs/polygon"},{"$ref":"#/$defs/multiPolygon"}]}
    },"additionalProperties":false}}
  },
  "additionalProperties":false,
  "$defs":{
    "position":{"type":"array","prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}],"items":false,"minItems":2,"maxItems":2},
    "ring":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/position"}},
    "polygon":{"type":"object","required":["type","coordinates"],"properties":{"type":{"const":"Polygon"},"coordinates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ring"}}},"additionalProperties":false},
    "multiPolygon":{"type":"object","required":["type","coordinates"],"properties":{"type":{"const":"MultiPolygon"},"coordinates":{"type":"array","minItems":1,"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ring"}}}},"additionalProperties":false}
  }
}
