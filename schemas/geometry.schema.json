{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["type","features"],
  "properties":{
    "type":{"const":"FeatureCollection"},
    "features":{"type":"array","minItems":1,"items":{"type":"object","required":["type","properties","geometry"],"properties":{
      "type":{"const":"Feature"},
      "properties":{"type":"object","required":["destinationId"],"properties":{"destinationId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},"additionalProperties":false},
      "geometry":{"oneOf":[{"$ref":"#/$defs/polygon"},{"$ref":"#/$defs/multiPolygon"}]}
    },"additionalProperties":false}}
  },
  "additionalProperties":false,
  "$defs":{
    "position":{"type":"array","prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}],"items":false,"minItems":2,"maxItems":2},
    "ring":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/position"}},
    "polygon":{"type":"object","required":["type","coordinates"],"properties":{"type":{"const":"Polygon"},"coordinates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ring"}}},"additionalProperties":false},
    "multiPolygon":{"type":"object","required":["type","coordinates"],"properties":{"type":{"const":"MultiPolygon"},"coordinates":{"type":"array","minItems":1,"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ring"}}}},"additionalProperties":false}
  }
}
