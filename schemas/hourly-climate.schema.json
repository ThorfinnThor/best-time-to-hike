{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","datasetStatus","source","destinationId","samplePointId","timezone","coordinates","gridElevationM","targetElevationM","precipitationSemantics","climateNormal","observations"],
  "properties":{
    "schemaVersion":{"const":1},
    "datasetStatus":{"enum":["fixture","production"]},
    "source":{"const":"era5Land"},
    "destinationId":{"$ref":"#/$defs/slug"},
    "samplePointId":{"$ref":"#/$defs/slug"},
    "timezone":{"type":"string","minLength":3},
    "coordinates":{"type":"object","required":["lat","lon"],"properties":{"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180}},"additionalProperties":false},
    "gridElevationM":{"type":"number"},
    "targetElevationM":{"type":"number"},
    "precipitationSemantics":{"enum":["INCREMENTAL_PER_TIMESTEP_M","ACCUMULATED_WITH_EXPLICIT_RESET_METADATA"]},
    "climateNormal":{"type":"object","required":["startYear","endYear"],"properties":{"startYear":{"const":1991},"endYear":{"const":2020}},"additionalProperties":false},
    "observations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/observation"}}
  },
  "additionalProperties":false,
  "$defs":{
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nullableNumber":{"type":["number","null"]},
    "observation":{"type":"object","required":["utcInstant","temperatureK","dewpointK","windUMs","windVMs","precipitationM","snowCover","snowDepthM"],"properties":{
      "utcInstant":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00\\.000Z$"},
      "temperatureK":{"$ref":"#/$defs/nullableNumber"},"dewpointK":{"$ref":"#/$defs/nullableNumber"},"windUMs":{"$ref":"#/$defs/nullableNumber"},"windVMs":{"$ref":"#/$defs/nullableNumber"},
      "precipitationM":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}]},"precipitationReset":{"type":"boolean"},
      "snowCover":{"anyOf":[{"type":"number","minimum":0,"maximum":1},{"type":"null"}]},"snowDepthM":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}]}
    },"additionalProperties":false}
  }
}
